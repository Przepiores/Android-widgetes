<?xml version="1.0" encoding="utf-8"?>
<!-- Zegar i data w prawym rogu pod paskiem. TextClock odświeża się sam, bez budzenia aplikacji. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_tight_extralight"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:letterSpacing="-0.03"
        android:textColor="@color/widget_text"
        android:textSize="26sp" />

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM"
        android:textColor="@color/widget_text"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
